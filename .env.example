# Chog NFT collection (ERC-721) on Monad mainnet — REQUIRED for real wallets
NEXT_PUBLIC_CHOG_CONTRACT=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
NEXT_PUBLIC_MONAD_RPC=https://rpc.monad.xyz

# Optional: real Chog token IDs to use in demo mode (comma separated)
DEMO_TOKEN_IDS=

# WalletConnect project id (free at cloud.reown.com) — enables mobile/QR wallets
NEXT_PUBLIC_WC_PROJECT_ID=

# Session signing secret (any long random string)
SESSION_SECRET=change-me

# Story AI — free keys. Gemini: aistudio.google.com/apikey · Groq: console.groq.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Storage for production (Upstash Redis free tier). Leave empty to use a local file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
